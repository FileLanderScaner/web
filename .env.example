# Copia este archivo como .env.local y completa los valores reales.
# Nunca subas .env.local al repositorio.

# Proyecto Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (usada para URLs canónicas, sitemap y redirects de auth)
# En desarrollo: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
